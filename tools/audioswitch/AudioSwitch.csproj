<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 低資源設定：閒置時零輪詢、關閉並行 GC、關閉分層編譯背景抖動 -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- 產品與版權資訊（顯示在檔案內容／關於） -->
    <Version>1.0.0</Version>
    <Product>AudioSwitch</Product>
    <Authors>masamoon</Authors>
    <Company>masamoon</Company>
    <Copyright>© 2026 masamoon. MIT License.</Copyright>
    <Description>一鍵切換 Windows 預設輸出／輸入裝置，耳麥麥克風自動跟著切。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 系統匣圖示從內嵌資源讀取 -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="tray.ico" LogicalName="tray.ico" />
  </ItemGroup>

</Project>
